# =============================================================
# DevPilot — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env a control de versiones.
# =============================================================

# -----------------------------------------------
# 🤖 API Keys para el Agente IA (al menos una)
# -----------------------------------------------

# Anthropic Claude (modo completo con Tool Use — Recomendado)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (soporte futuro / alternativa)
# Obtener en: https://platform.openai.com/
OPENAI_API_KEY=

# Google Gemini (soporte futuro)
# Obtener en: https://aistudio.google.com/
GEMINI_API_KEY=

# -----------------------------------------------
# 🔐 Seguridad JWT
# -----------------------------------------------

# Clave secreta para firmar tokens JWT (HS256).
# Usar una cadena larga y aleatoria en producción:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=devpilot-sre-super-secret-crypto-key-2026-auth-token

# Tiempo de expiración del token en segundos (default: 1800 = 30 min)
JWT_EXPIRATION_SECONDS=1800

# -----------------------------------------------
# 🗄️ Base de Datos
# -----------------------------------------------

# Ruta al archivo SQLite dentro del contenedor devpilot_core
DB_PATH=/app/data/devpilot.db

# -----------------------------------------------
# ⚙️ Runtime
# -----------------------------------------------

PYTHONUNBUFFERED=1

# -----------------------------------------------
# 🌐 Microservicios — Puertos (solo para dev local)
# -----------------------------------------------

# Puerto del DevPilot Core (FastAPI)
CORE_PORT=8000

# Puerto del servicio de Usuarios (Node.js/Express)
USERS_PORT=3001

# Puerto del servicio de Productos (FastAPI)
PRODUCTS_PORT=3002

# Puerto del servicio de Órdenes (FastAPI)
ORDERS_PORT=3003

# -----------------------------------------------
# 📧 Autenticación OTP por Correo (MFA Email)
# -----------------------------------------------

# Servidor SMTP (ej: smtp.gmail.com, smtp.office365.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true

# Credenciales de correo (Para Gmail, usar "App Password" de 16 caracteres)
SMTP_USER=
SMTP_PASSWORD=

# Remitente visible en los correos
SMTP_FROM=DevPilot SRE <noreply@devpilot.io>

# Expiración del código OTP en minutos (default: 5)
EMAIL_OTP_EXPIRE_MINUTES=5

# Modo desarrollo: Si es true y no hay SMTP configurado, el código se retorna en la API para pruebas locales
EMAIL_OTP_DEV_MODE=true
