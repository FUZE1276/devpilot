<?xml version="1.0" encoding="UTF-8"?>
<!--
  ==============================================================================
  DevPilot SRE Platform - Apache Maven Project Object Model (POM)
  Cumplimiento de:
  - Etapa 3: Construir (BUILD) - Diapositiva 6 (Apache Maven)
  - Etapa 4: Ensayo (TEST)     - Diapositiva 8 (JUnit 5)
  ==============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.devpilot.sre</groupId>
    <artifactId>devpilot-platform</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>DevPilot SRE Platform</name>
    <description>Quality Gate, Build Automation y JUnit Testing para DevPilot</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!-- JUnit 5 Jupiter API & Engine para Pruebas Unitarias (Etapa 4: Ensayo) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 1. Compilador de Java / Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                </configuration>
            </plugin>

            <!-- 2. Surefire Plugin: Ejecutor Oficial de Tests JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- 3. Exec Plugin: Compilación y Linting AST Multilenguaje -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>compile-ast-validation</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>powershell</executable>
                            <arguments>
                                <argument>-Command</argument>
                                <argument>Get-ChildItem -Path devpilot_core/*.py, microservices/*/*.py -Recurse | ForEach-Object { py -m py_compile $_.FullName } ; Write-Host "[MAVEN OK] Compilacion AST Python exitosa." -ForegroundColor Green</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- Verificación de Quality Gate en fase verify -->
                    <execution>
                        <id>quality-gate-verification</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>powershell</executable>
                            <arguments>
                                <argument>-ExecutionPolicy</argument>
                                <argument>Bypass</argument>
                                <argument>-File</argument>
                                <argument>./verify-build.ps1</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
